# Anystack Environment Configuration
# Add these to your .env file after setting up your Anystack account

# Enable Anystack integration
ANYSTACK_ENABLED=true

# Your Anystack Product ID (from your Anystack dashboard)
ANYSTACK_PRODUCT_ID=9f9d2843-f44a-4d2a-ad42-c65ac7728bb1

# Webhook secret for GitHub releases (provided by Anystack)
ANYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# API key for Anystack (if needed for license validation)
ANYSTACK_API_KEY=your_api_key_here

# GitHub webhook URL (provided by Anystack for automatic release sync)
ANYSTACK_GITHUB_WEBHOOK_URL=https://hooks.anystack.sh/github/your_webhook_id

# CodeForge License Configuration
# Get your license key from: https://anystack.sh/products/hkdevs-codeforge-database-studio
CODEFORGE_LICENSE_KEY=your_license_key_here
CODEFORGE_FINGERPRINT=your-domain.com
CODEFORGE_LICENSE_VALIDATION=true
