{
    "name": "hkdevs/codeforge-database-studio",
    "description": "Comprehensive Database Management and Code Generation Suite for FilamentPHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hardik Kanajariya",
            "email": "contact@hardikkanajariya.in",
            "homepage": "https://hardikkanajariya.in"
        }
    ],
    "homepage": "https://hardikkanajariya-in.github.io/codeforge/",
    "support": {
        "issues": "https://github.com/hardikkanajariya-in/codeforge/issues",
        "source": "https://github.com/hardikkanajariya-in/codeforge"
    },
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "doctrine/dbal": "^3.6",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "laravel/framework": "^10.0",
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HkDevs\\CodeForgeStudio\\CodeForgeStudioServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}