{
    "name": "hkdevs/codeforge-database-studio",
    "description": "Comprehensive database management and code generation suite for FilamentPHP panels.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "hardikkanajariya",
        "laravel",
        "filament",
        "filament-plugin",
        "filamentphp",
        "database",
        "migration",
        "schema",
        "code-generation",
        "codeforge-database-studio"
    ],
    "authors": [
        {
            "name": "Hardik Kanajariya",
            "email": "contact@hardikkanajariya.in",
            "homepage": "https://hardikkanajariya.in",
            "role": "Developer"
        }
    ],
    "homepage": "https://hardikkanajariya-in.github.io/codeforge/",
    "support": {
        "issues": "https://github.com/hardikkanajariya-in/codeforge/issues",
        "source": "https://github.com/hardikkanajariya-in/codeforge"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "doctrine/dbal": "^3.8|^4.0",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HkDevs\\CodeForgeStudio\\CodeForgeStudioServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
