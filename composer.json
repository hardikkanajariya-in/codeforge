{
    "name": "hkdevs/codeforge-database-studio",
    "description": "Premium Database Schema Manager Plugin for FilamentPHP",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "HkDevs",
            "email": "contact@hardikkanajariya.in"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "doctrine/dbal": "^3.6",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "laravel/framework": "^10.0",
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HkDevs\\CodeForgeStudio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HkDevs\\CodeForgeStudio\\CodeForgeStudioServiceProvider"
            ]
        },
        "anystack": {
            "product_id": "9f9d2843-f44a-4d2a-ad42-c65ac7728bb1",
            "license": "commercial",
            "pricing_tiers": [
                {
                    "name": "single",
                    "price": 79.00,
                    "currency": "EUR"
                },
                {
                    "name": "multiple",
                    "price": 129.00,
                    "currency": "EUR"
                },
                {
                    "name": "unlimited",
                    "price": 199.00,
                    "currency": "EUR"
                }
            ]
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}